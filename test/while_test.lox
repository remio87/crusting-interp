// Basic while loop
var i = 0;
while (i < 3) {
    print i;
    i = i + 1;
}
// 0, 1, 2

// Condition false from the start: body never executes
var x = 10;
while (x < 0) {
    print "should not print";
}

// Accumulator
var sum = 0;
var n = 1;
while (n <= 5) {
    sum = sum + n;
    n = n + 1;
}
print sum;  // 15

// Nested while
var row = 0;
while (row < 2) {
    var col = 0;
    while (col < 3) {
        col = col + 1;
    }
    print col;  // 3
    row = row + 1;
}
