// Basic for loop
for (var i = 0; i < 3; i = i + 1) {
    print i;
}
// 0, 1, 2

// Accumulator
var sum = 0;
for (var i = 1; i <= 5; i = i + 1) {
    sum = sum + i;
}
print sum;  // 15

// No initializer
var i = 0;
for (; i < 3; i = i + 1) {
    print i;
}
// 0, 1, 2

// No increment (condition only, like while)
var n = 3;
for (; n > 0;) {
    print n;
    n = n - 1;
}
// 3, 2, 1

// Condition false from the start: body never executes
for (var i = 0; i < 0; i = i + 1) {
    print "should not print";
}

// Infinite loop with all clauses omitted (comment out to avoid hanging)
// for (;;) { }
